# Blackbox AI Game Recommender - Environment Configuration
PORT=4000

# Real AI Model Configuration (Optional: system runs with built-in algorithmic engine if omitted)
# Google Gemini API Key (Recommended - Free Tier Available: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=key_goes_here

# Or OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Supabase Authentication & Database (Get from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

